FROM python:3.12-slim-bookworm

ENV HF_HOME=/models/huggingface \
    OMP_NUM_THREADS=5 \
    MKL_NUM_THREADS=5 \
    OPENBLAS_NUM_THREADS=5 \
    NUMEXPR_NUM_THREADS=5 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 && \
    rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.8.0
RUN pip install --no-cache-dir transformers==5.17.0 soundfile librosa

WORKDIR /bench
COPY backend_common.py canary_runner.py ./
ENTRYPOINT ["python", "/bench/canary_runner.py"]
