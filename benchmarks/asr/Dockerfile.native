FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl ffmpeg git g++ cmake ninja-build pkg-config \
    libsentencepiece-dev python3 && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v1.9.4 \
    https://github.com/ggml-org/whisper.cpp.git /opt/whisper.cpp && \
    cmake -S /opt/whisper.cpp -B /opt/whisper.cpp/build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF && \
    cmake --build /opt/whisper.cpp/build --parallel

RUN curl -fL --retry 5 --retry-all-errors \
      -o /tmp/nemo.tar.gz \
      https://github.com/NVIDIA/NeMo-Speech.cpp/releases/download/v0.1.0/nemo-speech-0.1.0-linux-x86_64-cpu.tar.gz && \
    printf '%s  %s\n' \
      0f74131d631ad2c694cf0ec53490866bb6461147959589a69fb6fc231944065b \
      /tmp/nemo.tar.gz | sha256sum -c - && \
    mkdir /opt/nemo && tar -xzf /tmp/nemo.tar.gz -C /opt/nemo --strip-components=1 && \
    rm /tmp/nemo.tar.gz

ENV PATH=/opt/nemo/bin:/opt/whisper.cpp/build/bin:$PATH
WORKDIR /bench
COPY native_runner.py .
ENTRYPOINT ["python3", "/bench/native_runner.py"]
