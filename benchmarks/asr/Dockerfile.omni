FROM python:3.12-slim-bookworm

ENV FAIRSEQ2_CACHE_DIR=/models/fairseq2/assets \
    OMP_NUM_THREADS=5 \
    MKL_NUM_THREADS=5 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ffmpeg libsndfile1 && \
    rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    torch==2.8.0+cpu torchaudio==2.8.0+cpu
RUN pip install --no-cache-dir --extra-index-url https://fair.pkg.atmeta.com/fairseq2/whl/pt2.8.0/cpu \
    'fairseq2[arrow]==0.6' \
    'https://github.com/facebookresearch/omnilingual-asr/archive/145a12a668aace6c1d0d290128c1225571fc1955.tar.gz'

WORKDIR /bench
COPY backend_common.py omni_runner.py ./
ENTRYPOINT ["python", "/bench/omni_runner.py"]
